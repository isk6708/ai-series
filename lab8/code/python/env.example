# Copy to .env and edit.  (copy .env.example .env)

# ---- Which LLM drives the chat: openai | ollama ----
LLM_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (e.g. GitHub Models, Azure)
# OPENAI_BASE_URL=

# ---- Ollama (local Llama) ----
# Start it first:  ollama pull llama3.2   then   ollama serve
# Use a model that supports tool calling: llama3.1, llama3.2, qwen2.5 ...
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ---- MCP server (server.py) ----
# http = Streamable HTTP (/mcp, current)   sse = legacy (/sse)
MCP_TRANSPORT=http
MCP_HTTP_URL=http://127.0.0.1:8000/mcp
MCP_SSE_URL=http://127.0.0.1:8000/sse
